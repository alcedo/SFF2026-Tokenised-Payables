{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.unit.config.mts"
  },
  "mutate": [
    "src/core/*.ts",
    "!src/core/fx.ts",
    "!src/core/input.ts",
    "!src/core/nav-active.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "clearTextReporter": {
    "logTests": false,
    "maxTestsToLog": 0
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 60,
    "low": 30,
    "break": 24
  }
}
